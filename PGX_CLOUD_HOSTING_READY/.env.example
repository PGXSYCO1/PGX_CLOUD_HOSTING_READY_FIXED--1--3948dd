# Google OAuth 2.0 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/auth/google/callback

# Flask session secret: replace with a long random value
PGX_SECRET_KEY=

# Set to 1 when your public domain uses HTTPS
PGX_COOKIE_SECURE=1

# Optional; many hosting providers inject PORT automatically
PORT=5000
